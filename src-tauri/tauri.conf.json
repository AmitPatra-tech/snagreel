{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snagreel",
  "version": "1.3.1",
  "identifier": "com.snagreel.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/tauri-prebuild.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Snagreel",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg"],
    "resources": {
      "binaries/whisper-cli.exe": "whisper-cli.exe",
      "binaries/whisper.dll": "whisper.dll",
      "binaries/ggml.dll": "ggml.dll",
      "binaries/ggml-base.dll": "ggml-base.dll",
      "binaries/ggml-cpu.dll": "ggml-cpu.dll",
      "binaries/ggml-base.bin": "ggml-base.bin"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AmitPatra-tech/snagreel-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBMkU3MTVBOUUzQjM0QkMKUldTOE5EdWVXbkV1eXNYVkVjb2daSlRhK1J4WjVSbWJtTXlCSTBwd2N0NHdndmlYVGpSUzA4QkwK"
    }
  }
}
