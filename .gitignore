# Node
node_modules/
dist/

# Rust / Tauri
src-tauri/target/
src-tauri/gen/schemas/

# Sidecar binaries (downloaded, not committed)
src-tauri/binaries/*.exe
src-tauri/binaries/yt-dlp
src-tauri/binaries/ffmpeg

# Secrets & signing keys (NEVER commit)
*.key
*.pem
*.p12
.env
.env.*
!.env.example

# Whisper speech-to-text engine + model (large, fetched by
# scripts/fetch-whisper.mjs at build time — see beforeBuildCommand — not
# committed)
src-tauri/binaries/*.bin
src-tauri/binaries/*.dll
src-tauri/binaries/whisper*
src-tauri/binaries/ggml*

# Scratch dir used by scripts/fetch-whisper.mjs while extracting
.whisper-fetch-tmp/

# Local machine settings
.claude/settings.local.json

# Misc
logo-square.png
*.log
.DS_Store

# Cloudflare Worker local secrets (NEVER commit)
licensing/.dev.vars
licensing/node_modules/
licensing/.wrangler/
